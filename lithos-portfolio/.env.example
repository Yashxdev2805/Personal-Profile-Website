# Copy this file to .env and fill in real values.
# .env is gitignored — it will never be committed.

# Google Apps Script Web App URL (see the deploy steps in README.md).
# The visitor gate POSTs { name, organization } here on first visit.
VITE_GATE_ENDPOINT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Your live domain, no trailing slash. Used for canonical/OG/Twitter tags
# and JSON-LD structured data in index.html.
VITE_SITE_URL=https://your-domain-here.com
